# Copia questo file in backend/.env e riempi i valori.
#
#     cp backend/.env.example backend/.env
#
# QUI DENTRO NON VANNO VALORI VERI. Questo file era pieno di credenziali di
# produzione — password del database, dell'amministratore e della casella di
# posta, piu' l'indirizzo del server e l'utente SSH — ed erano in tutti i
# commit. Peggio: il Dockerfile faceva `COPY .env.example ./.env`, quindi il
# container in esercizio partiva proprio con queste.
#
# I segreti non hanno piu' un valore di ripiego: senza, il programma si ferma
# e dice quali mancano. Vedi backend/src/config/env.js.

PORT=3000
CORS_ORIGIN=http://localhost:4200
APP_BASE_ORIGIN=http://localhost:4200

# Con docker compose l'host e' il nome del servizio: DB_HOST=db, DB_PORT=5432.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=turismo_db_dev
DB_USER=walkaround
DB_PASSWORD=

# always | if-empty | never
DB_SEED_MODE=if-empty

# Solo per la PRIMA installazione: creano l'amministratore se non esiste, e
# non lo toccano se c'e' gia'. Lasciarle vuote su un database avviato e' la
# cosa giusta: la password di chi amministra non deve stare nell'ambiente per
# sempre.
ADMIN_EMAIL=
ADMIN_PASSWORD=


AUTH_INVITE_TTL_HOURS=24

# Tutta la posta e' opzionale: senza queste tre l'invio e' spento e il
# programma parte lo stesso.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=

SMTP_FROM=Walk Around <no-reply@example.invalid>
