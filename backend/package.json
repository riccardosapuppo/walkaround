{
  "name": "walk-around-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "db:init": "node scripts/init-db.js",
    "translate:missing": "node scripts/translate-missing-pois.js",
    "translate:missing:dry-run": "node scripts/translate-missing-pois.js --dry-run",
    "audio:missing": "node scripts/generate-missing-poi-audios.js",
    "audio:missing:dry-run": "node scripts/generate-missing-poi-audios.js --dry-run",
    "audio:apply-manifest": "node scripts/apply-poi-audio-manifest.js",
    "audio:apply-manifest:dry-run": "node scripts/apply-poi-audio-manifest.js --dry-run",
    "audio:segnaposto": "node scripts/genera-audio-segnaposto.js",
